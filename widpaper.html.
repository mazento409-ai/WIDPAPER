<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>Widpaper</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap">
<style>
:root{--bg:#000;--accent:#5BC8FF;--navy:#0A1A3F;--line:#3A5A9A;--tx:#BFE6FF;--mut:#9AA7B5;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:#fff;font-family:Arial,Helvetica,sans-serif}
button{font:inherit}
button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.app{max-width:430px;margin:0 auto;padding:56px 16px 130px}
.tabs{display:flex;gap:8px}
.tabs button{flex:1;height:44px;border-radius:22px;border:1px solid var(--line);background:transparent;color:var(--tx);font-size:14px;cursor:pointer}
.tabs button.on{background:var(--accent);border-color:var(--accent);color:var(--navy);font-weight:700}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px;align-items:start}
.card{border-radius:20px;border:0;padding:0;cursor:pointer;width:100%}
h2{font-size:15px;color:var(--tx);margin:24px 0 0;font-weight:700;letter-spacing:.3px}
.nt{color:var(--mut);font-size:12px;margin:16px 0 0}
.w{border-radius:20px;background:linear-gradient(160deg,#1c1c22,#0c0c10);border:1px solid #26262e;padding:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;height:150px;overflow:hidden;text-align:center}
.w.wide{grid-column:1/-1;height:110px}
.w small{color:var(--mut);font-size:12px}
.fold{height:150px;border-radius:20px;background:#15151b;border:1px solid #26262e;padding:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.fold i{border-radius:12px;display:block}
.glass{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.bar{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(28px + env(safe-area-inset-bottom,0px));width:256px;height:56px;border-radius:34px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.3);box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 8px 32px rgba(0,0,0,.5);backdrop-filter:blur(30px) saturate(180%);-webkit-backdrop-filter:blur(30px) saturate(180%);display:flex;align-items:center;justify-content:space-around;z-index:5}
.bar button{width:52px;height:42px;border-radius:26px;border:0;background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:width .2s,background .2s}
.bar button.on{width:86px;background:rgba(255,255,255,.22)}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px;border-bottom:1px solid #1d1d24;font-size:15px}
.row span:last-child{color:var(--mut);text-align:right}
.tg{width:48px;height:28px;border-radius:14px;border:0;background:#333;position:relative;cursor:pointer;flex:none}
.tg::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:left .2s}
.tg.on{background:var(--accent)}.tg.on::after{left:23px}
.ico{width:96px;height:96px;border-radius:22px;background:var(--navy);color:var(--accent);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',Impact,sans-serif;font-size:25px;font-style:italic;margin:28px auto 8px}
.pv{position:fixed;inset:0;z-index:10;display:flex;align-items:flex-end;justify-content:center;padding:24px}
.pv button{height:48px;padding:0 28px;border-radius:24px;border:1px solid rgba(255,255,255,.5);background:rgba(255,255,255,.18);color:#fff;font-size:15px;cursor:pointer;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);margin-bottom:calc(16px + env(safe-area-inset-bottom,0px))}
@media (prefers-reduced-motion:reduce){.bar button,.tg::after{transition:none}}
</style>
</head>
<body>
<main class="app"><div class="tabs" id="tabs" role="group" aria-label="Brands"></div><div id="view"></div></main>
<nav class="bar" id="bar" aria-label="Sections"></nav>
<script>
const BRANDS=['iPhone','Xiaomi','Samsung','Oppo'];
const SECTIONS=['Wallpapers','Widgets','Settings'];
const ICONS=[
'<rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-9 9"/>',
'<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="18" height="8" rx="2"/>',
'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"/>'];
const IPHONE=['#FF8A5B,#6A2C91','#5BC8FF,#1B3A8A','#7AE0A8,#14526B','#FFD36B,#C2415D','#B58CFF,#2A1B6B','#FF6B8B,#3B1B5A'];
const HUE=[0,20,215,140];
const HEIGHTS=[230,190,190,230,230,190];
const FONTS=['Arial','Georgia','"Courier New"','Impact','"Trebuchet MS"','Verdana'];
const ACCENTS=['#5BC8FF','#FFB84D','#7AE0A8','#FF6B8B','#B58CFF','#FFD36B'];
const OPPO=[['Android 10','ColorOS 7'],['Android 11','ColorOS 11'],['Android 12','ColorOS 12'],['Android 13','ColorOS 13'],['Android 14','ColorOS 14'],['Android 15','ColorOS 15'],['Android 16','ColorOS 16'],['Android 17','ColorOS 17']];
const state={brand:0,section:0,notify:true};
const $=id=>document.getElementById(id);

function gradient(brand,i){
  if(brand===0)return `linear-gradient(160deg,${IPHONE[i]})`;
  const h=(HUE[brand]+i*55)%360;
  return `linear-gradient(${140+i*20}deg,hsl(${h},90%,64%),hsl(${(h+40)%360},70%,24%))`;
}
function oppoGradient(v,i){
  const h=(v*45+i*47)%360;
  return `radial-gradient(circle at ${20+i*20}% ${15+v*8}%,hsl(${h},85%,62%),transparent 60%),linear-gradient(${150+v*15}deg,hsl(${(h+30)%360},70%,30%),hsl(${(h+200)%360},60%,12%))`;
}
function clock(i){
  const d=new Date(),h=d.getHours(),m=d.getMinutes(),a=ACCENTS[i],f=FONTS[i];
  const p=n=>String(n).padStart(2,'0');
  if(i%3===0)return `<div style="font:700 44px ${f};color:${a}">${p(h)}:${p(m)}</div><small>${d.toDateString().slice(0,10)}</small>`;
  if(i%3===1)return `<svg width="110" height="110" viewBox="0 0 110 110" role="img" aria-label="Analog clock"><circle cx="55" cy="55" r="50" fill="none" stroke="${a}" stroke-width="3"/><line x1="55" y1="55" x2="55" y2="30" stroke="#fff" stroke-width="4" stroke-linecap="round" transform="rotate(${(h%12+m/60)*30} 55 55)"/><line x1="55" y1="55" x2="55" y2="16" stroke="${a}" stroke-width="3" stroke-linecap="round" transform="rotate(${m*6} 55 55)"/></svg>`;
  return `<div style="font:700 52px/.95 ${f};color:#fff">${p(h)}</div><div style="font:700 52px/.95 ${f};color:${a}">${p(m)}</div>`;
}
const clockCard=i=>`<div class="w" data-c="${i}">${clock(i)}</div>`;
const sunArc=()=>`<svg width="110" height="60" viewBox="0 0 110 60" role="img" aria-label="Sunrise and sunset arc"><path d="M10 55A45 45 0 0 1 100 55" fill="none" stroke="#FFB84D" stroke-width="3" stroke-dasharray="4 5"/><circle cx="55" cy="10" r="7" fill="#FFB84D"/><line x1="4" y1="55" x2="106" y2="55" stroke="#555"/></svg>`;
const sunIcon=()=>`<svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="12" fill="#FFD36B"/><g stroke="#FFD36B" stroke-width="3" stroke-linecap="round"><path d="M32 6v8M32 50v8M6 32h8M50 32h8M14 14l6 6M44 44l6 6M14 50l6-6M44 20l6-6"/></g></svg>`;
const wall=(bg,h,label)=>`<button type="button" class="card" data-bg="${bg}" data-label="${label}" aria-label="${label}" style="height:${h}px;background:${bg}"></button>`;

function wallpapers(b){
  if(b!==3){
    return `<div class="grid">${IPHONE.map((_,i)=>wall(gradient(b,i),HEIGHTS[i],`${BRANDS[b]} wallpaper ${i+1}`)).join('')}</div>`;
  }
  let o=`<p class="nt">Oppo-style approximations built from public ColorOS descriptions, not Oppo’s original files.</p>`;
  OPPO.slice().reverse().forEach((v,k)=>{
    const n=7-k;
    o+=`<h2>${v[0]} · ${v[1]}</h2><div class="grid">${[0,1,2,3].map(i=>wall(oppoGradient(n,i),HEIGHTS[i],`${v[1]} wallpaper ${i+1}`)).join('')}</div>`;
  });
  return o;
}
function widgets(b){
  if(b!==3){
    const names=['Battery','Calendar','Music','Weather'];
    return `<p class="nt">Generic placeholder widgets. ${BRANDS[b]} widgets are not researched yet.</p><h2>${BRANDS[b]} Clocks</h2><div class="grid">${[0,1,2,3,4,5].map(i=>clockCard((i+b)%6)).join('')}</div><h2>${BRANDS[b]} Widgets</h2><div class="grid">${names.map((n,i)=>`<div class="w"><div style="font:700 28px Arial;color:${ACCENTS[(i+b)%6]}">${n}</div><small>${BRANDS[b]} style</small></div>`).join('')}</div>`;
  }
  const sizes=[['1×1',1,1],['1×2',1,2],['2×1',2,1],['2×2',2,2]];
  return `<p class="nt">Oppo-style approximations built from public ColorOS descriptions, not Oppo’s original files.</p>
<h2>Flux Clocks (ColorOS 17)</h2><div class="grid">${[0,1,2,4].map(clockCard).join('')}</div>
<h2>Weather</h2><div class="grid"><div class="w">${sunIcon()}<small>Weather 2×2</small></div><div class="w">${sunArc()}<small>Sunrise / Sunset</small></div></div>
<h2>Currency Converter</h2><div class="grid"><div class="w"><div style="font:700 22px Arial;color:#5BC8FF">USD ⇄ EUR</div><small>2×2 · live rates</small></div><div class="w wide"><div style="font:700 24px Arial;color:#5BC8FF">USD · EUR · EGP · GBP</div><small>4×2 · live rates</small></div></div>
<h2>Sports Widget</h2><div class="grid"><div class="w wide"><div style="font:700 24px Arial;color:#7AE0A8">Match schedule · Live scores</div><small>Football tournaments</small></div></div>
<h2>Flux Home Screen sizes</h2><div class="grid" style="grid-template-columns:repeat(4,1fr)">${sizes.map(z=>`<div style="text-align:center"><div style="height:${z[2]*34}px;width:${z[1]*34}px;border-radius:12px;background:#15151b;border:1px solid #26262e;margin:0 auto"></div><small style="color:#9AA7B5;font-size:12px">${z[0]}</small></div>`).join('')}</div>
<h2>Glass Folders (ColorOS 17)</h2><div class="grid" style="background:${oppoGradient(7,2)};border-radius:20px;padding:14px">${[0,1,2,3].map(i=>`<div class="fold glass">${[0,1,2,3].map(k=>`<i style="background:${oppoGradient(7,(i+k)%4)}"></i>`).join('')}</div>`).join('')}</div>`;
}
function settings(){
  return `<div class="ico" role="img" aria-label="Widpaper icon">WIDPAPER</div><p style="text-align:center;color:#9AA7B5;margin:0 0 20px">Widpaper 1.0</p>
<div class="row"><span>Notifications</span><button type="button" class="tg${state.notify?' on':''}" id="tg" role="switch" aria-checked="${state.notify}" aria-label="Notifications"></button></div>
<div class="row"><span>Theme</span><span>Black</span></div>
<div class="row"><span>Brands</span><span>iPhone, Xiaomi, Samsung, Oppo</span></div>`;
}
function render(){
  const {brand:b,section:s}=state;
  $('tabs').style.display=s===2?'none':'flex';
  $('tabs').innerHTML=BRANDS.map((x,i)=>`<button type="button" class="${i===b?'on':''}" data-b="${i}" aria-pressed="${i===b}">${x}</button>`).join('');
  $('bar').innerHTML=SECTIONS.map((x,i)=>`<button type="button" class="${i===s?'on':''}" data-s="${i}" aria-label="${x}"${i===s?' aria-current="page"':''}><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[i]}</svg></button>`).join('');
  $('view').innerHTML=s===0?wallpapers(b):s===1?widgets(b):settings();
}
function preview(bg,label,opener){
  const d=document.createElement('div');
  d.className='pv';d.style.background=bg;
  d.setAttribute('role','dialog');d.setAttribute('aria-modal','true');d.setAttribute('aria-label',label);
  d.innerHTML='<button type="button">Close</button>';
  const close=()=>{d.remove();document.removeEventListener('keydown',esc);if(opener)opener.focus()};
  const esc=e=>{if(e.key==='Escape')close()};
  d.addEventListener('click',close);
  document.addEventListener('keydown',esc);
  document.body.appendChild(d);
  d.querySelector('button').focus();
}
document.addEventListener('click',e=>{
  const t=e.target.closest('button');
  if(!t)return;
  if(t.dataset.b!==undefined){state.brand=+t.dataset.b;render()}
  else if(t.dataset.s!==undefined){state.section=+t.dataset.s;render();window.scrollTo(0,0)}
  else if(t.id==='tg'){state.notify=!state.notify;t.classList.toggle('on',state.notify);t.setAttribute('aria-checked',state.notify)}
  else if(t.dataset.bg){preview(t.dataset.bg,t.dataset.label,t)}
});
setInterval(()=>document.querySelectorAll('[data-c]').forEach(el=>{el.innerHTML=clock(+el.dataset.c)}),30000);
render();
</script>
</body>
</html>
